---
layout: null
---
{
  "studio": {
    "name": "AISUNI",
    "symbol": "✷",
    "badge": "Archivo Activo",
    "email": "contacto@aisuni.art",
    "location": "Barcelona, ES",
    "timezone": "Europe/Madrid",
    "manifesto": "Investigación en artes visuales y sistemas generativos: un espacio de experimentación con tecnologías emergentes y herramientas algorítmicas para nuevas inteligencias visuales."
  },
  "proyectos": [
    {% assign sorted_proyectos = site.proyectos | sort: "num" %}
    {% for item in sorted_proyectos %}
    {
      "id": {{ item.id | split: "/" | last | jsonify }},
      "slug": {{ item.front_id | default: item.id | split: "/" | last | jsonify }},
      "num": {{ item.num | jsonify }},
      "title": {{ item.title | jsonify }},
      "category": {{ item.category | jsonify }},
      "categoryTag": {{ item.categoryTag | jsonify }},
      "year": {{ item.year | jsonify }},
      "client": {{ item.client | jsonify }},
      "image": {{ item.image | jsonify }},
      "gallery": {{ item.gallery | jsonify }},
      "tools": {{ item.tools | jsonify }},
      "status": {{ item.status | jsonify }},
      "rawMarkdown": {{ item.raw_content | default: item.content | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "archivo": [
    {% assign sorted_archivo = site.archivo | sort: "num" %}
    {% for item in sorted_archivo %}
    {
      "id": {{ item.id | split: "/" | last | jsonify }},
      "slug": {{ item.front_id | default: item.id | split: "/" | last | jsonify }},
      "num": {{ item.num | jsonify }},
      "title": {{ item.title | jsonify }},
      "category": {{ item.category | jsonify }},
      "categoryTag": {{ item.categoryTag | jsonify }},
      "year": {{ item.year | jsonify }},
      "client": {{ item.client | jsonify }},
      "image": {{ item.image | jsonify }},
      "gallery": {{ item.gallery | jsonify }},
      "tools": {{ item.tools | jsonify }},
      "status": {{ item.status | jsonify }},
      "rawMarkdown": {{ item.raw_content | default: item.content | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
