---
layout: null
---
{
  "jekyllCompiled": true,
  "generatedAt": {{ site.time | date_to_xmlschema | jsonify }},
  "studio": {
    "name": "AISUNI",
    "symbol": "✷",
    "badge": "Archivo Activo",
    "email": "contacto@aisuni.art",
    "location": "New York · Barcelona",
    "timezone": "America/New_York"
  },
  "proyectos": [
    {% assign first_p = true %}
    {% for item in site.proyectos %}
      {% unless first_p %},{% endunless %}{% assign first_p = false %}
      {
        "id": {{ item.path | split: "/" | last | replace: ".md", "" | jsonify }},
        "path": {{ item.path | jsonify }},
        "num": {{ item.num | jsonify }},
        "title": {{ item.title | default: item.slug | jsonify }},
        "category": {{ item.category | jsonify }},
        "categoryTag": {{ item.categoryTag | jsonify }},
        "year": {{ item.year | jsonify }},
        "client": {{ item.client | jsonify }},
        "image": {{ item.image | jsonify }},
        "gallery": {{ item.gallery | jsonify }},
        "tools": {{ item.tools | jsonify }},
        "status": {{ item.status | jsonify }},
        "concepto": {{ item.concepto | jsonify }},
        "proceso": {{ item.proceso | jsonify }},
        "content": {{ item.content | jsonify }},
        "rawContent": {{ item.raw_content | jsonify }}
      }
    {% endfor %}
    {% for item in site.pages %}
      {% if item.path contains "proyectos/" and item.name contains ".md" %}
        {% unless first_p %},{% endunless %}{% assign first_p = false %}
        {
          "id": {{ item.name | replace: ".md", "" | jsonify }},
          "path": {{ item.path | jsonify }},
          "num": {{ item.num | jsonify }},
          "title": {{ item.title | default: item.name | replace: ".md", "" | jsonify }},
          "category": {{ item.category | jsonify }},
          "categoryTag": {{ item.categoryTag | jsonify }},
          "year": {{ item.year | jsonify }},
          "client": {{ item.client | jsonify }},
          "image": {{ item.image | jsonify }},
          "gallery": {{ item.gallery | jsonify }},
          "tools": {{ item.tools | jsonify }},
          "status": {{ item.status | jsonify }},
          "concepto": {{ item.concepto | jsonify }},
          "proceso": {{ item.proceso | jsonify }},
          "content": {{ item.content | jsonify }},
          "rawContent": {{ item.raw_content | jsonify }}
        }
      {% endif %}
    {% endfor %}
  ],
  "archivo": [
    {% assign first_a = true %}
    {% for item in site.archivo %}
      {% unless first_a %},{% endunless %}{% assign first_a = false %}
      {
        "id": {{ item.path | split: "/" | last | replace: ".md", "" | jsonify }},
        "path": {{ item.path | jsonify }},
        "num": {{ item.num | jsonify }},
        "title": {{ item.title | default: item.slug | jsonify }},
        "category": {{ item.category | jsonify }},
        "categoryTag": {{ item.categoryTag | jsonify }},
        "year": {{ item.year | jsonify }},
        "client": {{ item.client | jsonify }},
        "image": {{ item.image | jsonify }},
        "gallery": {{ item.gallery | jsonify }},
        "tools": {{ item.tools | jsonify }},
        "status": {{ item.status | jsonify }},
        "concepto": {{ item.concepto | jsonify }},
        "proceso": {{ item.proceso | jsonify }},
        "content": {{ item.content | jsonify }},
        "rawContent": {{ item.raw_content | jsonify }}
      }
    {% endfor %}
    {% for item in site.pages %}
      {% if item.path contains "archivo/" and item.name contains ".md" %}
        {% unless first_a %},{% endunless %}{% assign first_a = false %}
        {
          "id": {{ item.name | replace: ".md", "" | jsonify }},
          "path": {{ item.path | jsonify }},
          "num": {{ item.num | jsonify }},
          "title": {{ item.title | default: item.name | replace: ".md", "" | jsonify }},
          "category": {{ item.category | jsonify }},
          "categoryTag": {{ item.categoryTag | jsonify }},
          "year": {{ item.year | jsonify }},
          "client": {{ item.client | jsonify }},
          "image": {{ item.image | jsonify }},
          "gallery": {{ item.gallery | jsonify }},
          "tools": {{ item.tools | jsonify }},
          "status": {{ item.status | jsonify }},
          "concepto": {{ item.concepto | jsonify }},
          "proceso": {{ item.proceso | jsonify }},
          "content": {{ item.content | jsonify }},
          "rawContent": {{ item.raw_content | jsonify }}
        }
      {% endif %}
    {% endfor %}
  ],
  "staticMdFiles": [
    {% assign first_s = true %}
    {% for f in site.static_files %}
      {% if f.extname == ".md" %}
        {% if f.path contains "proyectos/" or f.path contains "archivo/" %}
          {% unless first_s %},{% endunless %}{% assign first_s = false %}
          {
            "path": {{ f.path | jsonify }},
            "name": {{ f.name | jsonify }}
          }
        {% endif %}
      {% endif %}
    {% endfor %}
  ]
}
