---
layout: null
---
[
  {% assign all_items = site.proyectos | concat: site.archivo %}
  {% for item in all_items %}
  {
    "id": "{{ item.id }}",
    "num": "{{ item.num }}",
    "title": "{{ item.title }}",
    "category": "{{ item.category }}",
    "categoryTag": "{{ item.categoryTag }}",
    "year": "{{ item.year }}",
    "client": "{{ item.client }}",
    "image": "{{ item.image }}",
    "gallery": [
      {% for img in item.gallery %}
        "{{ img }}"{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    "tools": "{{ item.tools }}",
    "status": "{{ item.status }}"
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]

